# Yönetici paneli şifresi (yetkili kişilerle paylaşılacak ortak şifre)
ADMIN_PASSWORD=degistir-beni
# Oturum çerezini imzalamak için uzun rastgele bir metin
SESSION_SECRET=uzun-rastgele-bir-metin
# Panelin adresi: https://siteadresi.com/yonetim-xxxx  (tahmin edilmesi zor bir yol seçin)
ADMIN_PATH=/yonetim
PORT=3000

# E-posta onayı (isteğe bağlı, boş bırakılırsa mail gönderilmez)
# Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=adres@gmail.com,
# SMTP_PASS=<Google hesabında oluşturulan 16 haneli "Uygulama şifresi">
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
